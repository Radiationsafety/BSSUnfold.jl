# Julia dependencies declaration for juliacall
# See https://cjdoris.github.io/PythonCall.jl/stable/juliacall/
# When bssunfold_julia is imported, julia-pkg reads this file
# and installs BSSUnfold.jl automatically on first run.

[deps]
BSSUnfold = "7c4f9e3a-2b8d-4f1e-9c5b-8a1d6e3f0c2a"

[compat]
julia = "1.10"
BSSUnfold = "0.1"
